generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  RESEARCHED
  ANALYZED
  QUALIFIED
  DEMO_CREATED
  MESSAGE_READY
  WAITING_FOR_REVIEW
  APPROVED
  CONTACTED
  REPLIED
  CONVERTED
  REJECTED
}

/// A discovered local business, tracked through the full pipeline
/// from research to (eventually, human-approved) outreach.
model Lead {
  id             String     @id @default(cuid())

  companyName    String
  normalizedName String
  industry       String?
  location       String?
  website        String?
  domain         String?

  contactName    String?
  contactEmail   String?
  contactPhone   String?
  address        String?

  source         String
  sourceRef      String?

  status         LeadStatus @default(NEW)
  websiteScore   Int?
  leadScore      Int?
  scoreReasons   Json?

  analysis       WebsiteAnalysis?
  demo           Demo?
  message        Message?
  activity       ActivityLog[]

  lastErrorAt    DateTime?
  lastError      String?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([domain])
  @@index([normalizedName])
  @@index([status])
  @@index([leadScore])
}

/// Structured, modular website analysis. Each dimension stores a
/// score plus notes, and explicitly flags what could not be verified
/// rather than guessing.
model WebsiteAnalysis {
  id                  String   @id @default(cuid())
  leadId              String   @unique
  lead                Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  design              Json
  mobileUx            Json
  navigation          Json
  performance         Json
  content             Json
  cta                 Json
  trust               Json
  contactExperience   Json
  accessibility       Json
  conversionPotential Json

  strengths           Json
  weaknesses          Json
  opportunities       Json

  rawSignals          Json?
  fetchedAt           DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// A generated static demo site for a lead, isolated from the dashboard.
model Demo {
  id          String   @id @default(cuid())
  leadId      String   @unique
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  slug        String   @unique
  templateKey String
  outputDir   String
  placeholders Json

  /// Set once Phase 11 (Cloudflare) actually publishes this demo. Null
  /// means it only exists as a local preview under /public/demos.
  publicUrl   String?
  publishedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A drafted outreach message awaiting human review. Sending is a
/// separate, explicit, human-triggered action handled elsewhere.
model Message {
  id           String    @id @default(cuid())
  leadId       String    @unique
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  subject      String?
  body         String
  editedByUser Boolean   @default(false)

  approvedAt   DateTime?
  rejectedAt   DateTime?
  sentAt       DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Append-only log for pipeline transparency: status changes, per-lead
/// loop errors (which must not stop the overall run), and notes.
model ActivityLog {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type      String
  message   String
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([type])
}
