generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  RESEARCHED
  ANALYZED
  QUALIFIED
  DEMO_CREATED
  MESSAGE_READY
  WAITING_FOR_REVIEW
  APPROVED
  CONTACTED
  REPLIED
  CONVERTED
  REJECTED
}

/// A discovered local business, tracked through the full pipeline
/// from research to (eventually, human-approved) outreach.
model Lead {
  id             String     @id @default(cuid())

  companyName    String
  normalizedName String
  industry       String?
  /// Extra real, source-provided classification when available (e.g.
  /// OSM's cuisine tag for a restaurant) — never inferred/invented.
  specialty      String?
  location       String?
  website        String?
  domain         String?
  /// Real coordinates of this exact business, straight off the OSM
  /// element (a node's own lat/lon, or a way's `center` from Overpass's
  /// `out center`) — never geocoded/guessed separately, and distinct
  /// from Nominatim's city-level place lookup used only for the search
  /// radius. Null for leads researched before this field existed, or
  /// any future source that doesn't provide coordinates. Powers the
  /// real embedded location map in the demo (see demo-generator).
  latitude       Float?
  longitude      Float?

  contactName    String?
  /// Denormalized primary contact email, always mirrored from the
  /// ContactEmail row Contact Discovery marked `isPrimary` — never set by
  /// hand, so the message/Gmail-draft pipeline can keep reading this one
  /// field without joining `contactEmails` everywhere.
  contactEmail   String?
  contactEmailSource     String?
  contactEmailConfidence String?
  contactEmailSourceUrl  String?
  contactEmailFoundAt    DateTime?
  /// 0-100, see contact-discovery/rank.ts — reflects source trustworthiness,
  /// never mailbox deliverability (no send/verify probe exists).
  contactQualityScore    Int?
  /// Set when the last discovery run found nothing (or the site was
  /// unreachable) — null once a candidate exists, so the dashboard can
  /// distinguish "never looked" from "looked, found nothing".
  contactDiscoveryError  String?
  contactPhone   String?
  address        String?

  source         String
  sourceRef      String?

  status         LeadStatus @default(NEW)
  websiteScore   Int?
  leadScore      Int?
  scoreReasons   Json?

  analysis       WebsiteAnalysis?
  demo           Demo?
  message        Message?
  activity       ActivityLog[]
  contactEmails  ContactEmail[]

  lastErrorAt    DateTime?
  lastError      String?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([domain])
  @@index([normalizedName])
  @@index([status])
  @@index([leadScore])
}

/// Structured, modular website analysis. Each dimension stores a
/// score plus notes, and explicitly flags what could not be verified
/// rather than guessing.
model WebsiteAnalysis {
  id                  String   @id @default(cuid())
  leadId              String   @unique
  lead                Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  design              Json
  mobileUx            Json
  navigation          Json
  performance         Json
  content             Json
  cta                 Json
  trust               Json
  contactExperience   Json
  accessibility       Json
  conversionPotential Json

  strengths           Json
  weaknesses          Json
  opportunities       Json

  rawSignals          Json?

  /// Real viewport screenshots of the lead's *current* live site — the
  /// "Vorher" half of the Before/After comparison. Paths are relative to
  /// public/screenshots/<leadId>/. Null when capture failed (site down,
  /// blocked, Chromium unavailable) — see screenshotError, never guessed.
  screenshotDesktopPath String?
  screenshotMobilePath  String?
  screenshotError       String?

  fetchedAt           DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// One real, sourced business email finding for a lead — Contact
/// Discovery may find several (info@, kontakt@, a named person); exactly
/// one is flagged isPrimary at a time, mirrored onto Lead.contactEmail.
model ContactEmail {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  email      String
  /// Human-readable source page/channel — "Impressum", "Kontaktseite",
  /// "Startseite", "Datenschutzerklärung", "Über uns", "Team", or
  /// "OpenStreetMap" for the one non-crawled, structured-directory source.
  source     String
  sourceUrl  String
  /// HIGH | MEDIUM | LOW — see contact-discovery/rank.ts. Never upgraded
  /// beyond what the source actually supports.
  confidence String
  isPrimary  Boolean  @default(false)

  foundAt    DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([leadId, email])
  @@index([leadId])
}

/// A generated static demo site for a lead, isolated from the dashboard.
model Demo {
  id          String   @id @default(cuid())
  leadId      String   @unique
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  slug        String   @unique
  templateKey String
  outputDir   String
  placeholders Json

  /// Set once Cloudflare Pages actually publishes this demo (see
  /// publishing/publish-demo.ts). Null means it only exists as a local
  /// preview under /public/demos.
  publicUrl   String?
  publishedAt DateTime?

  /// Real viewport screenshots of this generated demo, captured straight
  /// off the rendered index.html via file:// (no server required) — the
  /// "Nachher" half of the Before/After comparison. Relative to
  /// public/demos/<slug>/assets/. Null when capture failed.
  afterScreenshotDesktopPath String?
  afterScreenshotMobilePath  String?

  /// The computed VisualProfile (art direction, colors, typography,
  /// layout/motion direction, asset plan) this demo was built from.
  visualProfile Json?
  assets        DemoAsset[]

  /// Which named concept variant (Premium Editorial, Bold Conversion, …)
  /// this build used, and every variant id used so far for this lead —
  /// so "Demo neu erstellen" can pick a genuinely different one instead
  /// of repeating the same structure.
  conceptVariant String?
  variantHistory Json?

  /// Full research-driven concept breakdown (business profile, website
  /// audit summary, opportunity map, content structure, design concept)
  /// shown in the dashboard's demo detail area.
  concept Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One visual asset used in a demo — a real photo extracted from the
/// lead's own existing website, an AI-generated image (once a provider
/// is configured), or a deterministic abstract SVG composition. Never a
/// generic stock photo.
model DemoAsset {
  id       String @id @default(cuid())
  demoId   String
  demo     Demo   @relation(fields: [demoId], references: [id], onDelete: Cascade)

  role     String
  source   String
  altText  String

  /// Relative path under public/demos/<slug>/assets/, or null for an
  /// inline-rendered abstract SVG (no file on disk).
  localPath String?
  sourceUrl String?

  width       Int?
  height      Int?
  aspectRatio String
  /// { webp?: string, avif?: string, original?: string } — relative
  /// paths per generated format, when this asset has files on disk.
  formats     Json?

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([demoId])
}

/// A drafted outreach message awaiting human review. Sending is a
/// separate, explicit, human-triggered action handled elsewhere.
model Message {
  id           String    @id @default(cuid())
  leadId       String    @unique
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  subject      String?
  body         String
  editedByUser Boolean   @default(false)

  approvedAt   DateTime?
  rejectedAt   DateTime?
  sentAt       DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Append-only log for pipeline transparency: status changes, per-lead
/// loop errors (which must not stop the overall run), and notes.
model ActivityLog {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type      String
  message   String
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([type])
}
