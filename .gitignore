# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (local dev data, never committed)
/prisma/*.db
/prisma/*.db-journal
*.sqlite
*.sqlite3

# generated demo sites (per-lead output, not committed)
/public/demos/*
!/public/demos/.gitkeep

# ...except the industry showcase demos, which ARE committed: they are
# the reference set shown to customers, not per-lead output, and they
# must stay reproducible with the code that produced them.
!/public/demos/_showcase/
!/public/demos/_showcase/**

# Their video files are committed too, via Git LFS (see .gitattributes)
# rather than as raw blobs — ~50MB per industry, so storing them inline
# would put a permanent copy of every regeneration into git history.
# LFS keeps the working repo small and replaces them with pointers.
# Note the quota: GitHub's free tier is 1GB of LFS storage and 1GB of
# bandwidth per month, and the current set already uses roughly two
# thirds of that.

# captured before/after screenshots (per-lead output, not committed)
/public/screenshots/*
!/public/screenshots/.gitkeep

# Per-lead exports for the React engine. Same reason the per-lead demos
# above stay out: they carry a real prospect's company name, address and
# contact email, and this repository is public. Only the _showcase set
# (Musterfirma, no real data) is committed.
/demo-app/public/data/*
!/demo-app/public/data/.gitkeep

# staged tree actually deployed to the shared Cloudflare Pages project
# (see cloudflare-publisher.ts) — mirrors published leads' demo output,
# not source
/.cloudflare-deploy/

# editor
.vscode/*
!.vscode/extensions.json

# locally-installed Claude Code skills (npx skills add) — .agents/skills
# holds the real files, .claude/skills symlinks into it using absolute
# paths, so neither is portable across machines. skills-lock.json (not
# ignored) is the portable manifest; run `npx skills add <source>` to
# regenerate these locally.
/.agents/
/.claude/skills/

# Full-quality watermarked video masters. No page requests them — the
# page-wide background plays the -scrub encode — so they were 118 MB of
# pure weight inside public/demos: carried by every LFS push and
# re-uploaded on every publish, for bytes no visitor fetches.
#
# Kept rather than deleted because re-encoding a scrub from its master
# measures VMAF 81.3 against 76.6 from an existing scrub, and that loss
# would compound with every future pass. Reproducible by regenerating
# the clip (~$0.24 each), so not worth LFS quota.
/.video-masters/
