# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (local dev data, never committed)
/prisma/*.db
/prisma/*.db-journal
*.sqlite
*.sqlite3

# generated demo sites (per-lead output, not committed)
/public/demos/*
!/public/demos/.gitkeep

# ...except the industry showcase demos, which ARE committed: they are
# the reference set shown to customers, not per-lead output, and they
# must stay reproducible with the code that produced them.
!/public/demos/_showcase/
!/public/demos/_showcase/**

# Their video files are deliberately still excluded. They are ~50MB per
# industry (473MB across nine, and every regeneration would add another
# permanent copy to git history, which cannot be removed without
# rewriting it). The HTML and images — the part that is actually
# reviewed and versioned — are 7MB in total. Regenerate the clips with
# scripts/generate-industry-demo.ts, or serve them from the Cloudflare
# Pages deploy this project already builds.
/public/demos/_showcase/**/*.mp4

# captured before/after screenshots (per-lead output, not committed)
/public/screenshots/*
!/public/screenshots/.gitkeep

# staged tree actually deployed to the shared Cloudflare Pages project
# (see cloudflare-publisher.ts) — mirrors published leads' demo output,
# not source
/.cloudflare-deploy/

# editor
.vscode/*
!.vscode/extensions.json

# locally-installed Claude Code skills (npx skills add) — .agents/skills
# holds the real files, .claude/skills symlinks into it using absolute
# paths, so neither is portable across machines. skills-lock.json (not
# ignored) is the portable manifest; run `npx skills add <source>` to
# regenerate these locally.
/.agents/
/.claude/skills/
