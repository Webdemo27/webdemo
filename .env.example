# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# --- Database (Phase 2) ---
# Local SQLite for development. Swap to a hosted Postgres URL later without code changes.
DATABASE_URL="file:./prisma/dev.db"

# --- Gmail integration ---
# Set all three below to enable the real "Gmail-Entwurf vorbereiten" button
# (creates a real Gmail draft via the Gmail API — never auto-sends; a human
# always opens Gmail and clicks Send themselves). Without them, the button
# fails closed with a clear error and the dashboard falls back to
# copy-to-clipboard.
GMAIL_SENDER_ADDRESS="hacibekircayir@gmail.com"
# OAuth2 credentials for the Gmail API (never use raw passwords).
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

# --- Outreach signature (used in message drafts) ---
SENDER_NAME=""
SENDER_PHONE=""
SENDER_WHATSAPP=""

# --- Cloudflare Pages (public demo hosting) ---
# Set both to enable the real "Öffentlich bereitstellen" button (uploads the
# demo to a shared Cloudflare Pages project and verifies the resulting
# HTTPS URL is actually reachable before saving it). Without them, the
# button fails closed with a clear error.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
# Optional: every lead's demo lives at its own path in ONE shared Pages
# project (https://<project>.pages.dev/<slug>/) rather than one project per
# lead — the free plan caps an account at 100 projects, which one-per-lead
# hits fast. Defaults to "webdemo-demos"; only set this if that name is
# already taken by something else on your Cloudflare account.
CLOUDFLARE_PAGES_PROJECT=""

# --- AI image generation (optional, not required) ---
# Without this, demos use real images extracted from the lead's own
# website and/or deterministic abstract art instead — never invented.
OPENAI_API_KEY=""
