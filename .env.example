# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# --- Database (Phase 2) ---
# Local SQLite for development. Swap to a hosted Postgres URL later without code changes.
DATABASE_URL="file:./prisma/dev.db"

# --- Gmail integration (Phase 10, not implemented yet) ---
# Sender address for outbound messages. Real sending stays disabled until built in Phase 10.
GMAIL_SENDER_ADDRESS="hacibekircayir@gmail.com"
# OAuth2 credentials for the Gmail API (never use raw passwords).
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

# --- Cloudflare (Phase 11, not implemented yet) ---
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# --- AI image generation (optional, not required) ---
# Without this, demos use real images extracted from the lead's own
# website and/or deterministic abstract art instead — never invented.
OPENAI_API_KEY=""
